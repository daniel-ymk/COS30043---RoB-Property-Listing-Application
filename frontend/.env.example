# Copy to .env.development.local (gitignored) for local overrides.

# Where the PHP API lives (docs/api.md section 1). In dev these are proxied
# by vite.config.js to XAMPP; for Mercury set the full sub-folder paths, e.g.
#   VITE_BASE=/~s1234567/rob/
#   VITE_API_BASE=/~s1234567/rob/backend/api
#   VITE_BACKEND_URL=/~s1234567/rob/backend
VITE_BASE=/
VITE_API_BASE=/api
VITE_BACKEND_URL=/backend

# Where XAMPP's Apache listens (dev proxy target).
VITE_PHP_TARGET=http://localhost
