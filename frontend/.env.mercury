# Build for Mercury: npm run build -- --mode mercury (scripts/build-mercury.sh
# does this and assembles the upload folder). No secrets in here.
# Site: https://mercury.swin.edu.au/cos30043/s105229648/rob/

VITE_BASE=/cos30043/s105229648/rob/
# index.php/<route> works whether or not the server allows .htaccess rewrites
VITE_API_BASE=/cos30043/s105229648/rob/backend/api/index.php
VITE_BACKEND_URL=/cos30043/s105229648/rob/backend

# history: clean URLs, needs the .htaccess fallback to index.html
# hash:    /#/properties/5, works on any server
VITE_ROUTER_MODE=history
